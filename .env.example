# ==============================================================================
# HORIZON REALTY — MASTER REALTIME CRM CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

PORT=5000
NODE_ENV=development
CRM_NAME="Horizon Realty Master Realtime CRM"
BASE_SERVER_URL=http://localhost:5000
JWT_SECRET=your_super_secret_jwt_key_here

# FIREBASE / CLOUD FIRESTORE
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIRESTORE_LEADS_COLLECTION=leads
FIRESTORE_ACTIVITIES_COLLECTION=activities
FIRESTORE_USERS_COLLECTION=users

# META ADS (FACEBOOK & INSTAGRAM)
META_VERIFY_TOKEN=your_meta_verify_token
META_APP_SECRET=your_meta_app_secret
META_ACCESS_TOKEN=your_meta_system_user_access_token
META_GRAPH_API_VERSION=v19.0
META_WEBHOOK_URL=http://localhost:5000/webhook/meta

# 99ACRES PULL API (add values only in your local .env)
NNACRES_PULL_API_URL=https://www.99acres.com/99api/v1/getmy99Response/your_api_key/uid/
NNACRES_USERNAME=your_99acres_username
NNACRES_PASSWORD=your_99acres_password
NNACRES_MOCK_MODE=false

# WEBSITE & GOOGLE ADS
WEBSITE_WEBHOOK_SECRET=your_website_secret
WEBSITE_WEBHOOK_URL=http://localhost:5000/webhook/website
GOOGLE_ADS_WEBHOOK_KEY=your_google_ads_key
GOOGLE_ADS_WEBHOOK_URL=http://localhost:5000/webhook/google

# WHATSAPP & PHONE
DEFAULT_PHONE_COUNTRY_CODE=91

# CRM USERS
ADMIN_EMAIL=admin@estate.com
ADMIN_PASSWORD=admin123
ADMIN_NAME="Managing Partner"

AGENT_EMAIL=agent@estate.com
AGENT_PASSWORD=agent123
AGENT_NAME="Senior Sales Advisor"
